@page
@model IslandCore.Pages.SalesModel
@{
    ViewData["Title"] = "Sales";
    ViewData["ActivePage"] = "Sales";
}

<div class="card">
    <form method="get" class="filter-bar">
        <div class="form-group">
            <label>Customer</label>
            <input type="text" name="customer" value="@Model.CustomerFilter" placeholder="Search customer…"/>
        </div>
        <div class="form-group">
            <label>From</label>
            <input type="date" name="from" value="@Model.FromDate"/>
        </div>
        <div class="form-group">
            <label>To</label>
            <input type="date" name="to" value="@Model.ToDate"/>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
        <a href="/Sales" class="btn btn-ghost btn-sm">Clear</a>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th><th>Customer</th><th>SKU</th><th>Product</th>
                    <th>Qty</th><th>Unit Price</th><th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sales)
                {
                    <tr>
                        <td>@(s.CreatedUtc == DateTime.MinValue ? "—" : s.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                        <td>@s.Customer</td>
                        <td><code>@s.SKU</code></td>
                        <td>@s.ProductName</td>
                        <td>@s.Quantity</td>
                        <td>@s.UnitPrice.ToString("C0")</td>
                        <td style="font-weight:600;">@s.TotalAmount.ToString("C0")</td>
                    </tr>
                }
                @if (!Model.Sales.Any())
                {
                    <tr><td colspan="7" style="text-align:center;color:#6b7f95;padding:32px;">No sales records found</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div style="font-size:13px;color:#6b7f95;margin-top:12px;">
        @Model.Sales.Count record(s) &nbsp;·&nbsp; Total: <strong>@Model.Sales.Sum(s => s.TotalAmount).ToString("C0")</strong>
    </div>
</div>

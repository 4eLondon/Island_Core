@page
@model IslandCore.Pages.ReportsModel
@{
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "Reports";
}

<div style="font-size:13px;color:#6b7f95;margin-bottom:20px;">
    <strong style="color:#0b2946;">Summary:</strong>
    Total stock units: <strong>@Model.TotalStockUnits</strong> &nbsp;·&nbsp;
    Distinct items: <strong>@Model.DistinctItems</strong> &nbsp;·&nbsp;
    Total sales: <strong>@Model.TotalSales.ToString("C0")</strong>
</div>

<div class="card">
    <div class="card-title">Inventory Report</div>
    <form method="get" class="filter-bar" style="margin-bottom:16px;">
        <input type="hidden" name="salesCustomer" value="@Model.SalesCustomer"/>
        <input type="hidden" name="salesFrom" value="@Model.SalesFrom"/>
        <input type="hidden" name="salesTo" value="@Model.SalesTo"/>
        <div class="form-group">
            <label>Category</label>
            <select name="invCategory" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var c in Model.InvCategories)
                { <option value="@c" selected="@(Model.InvCategory==c)">@c</option> }
            </select>
        </div>
        <div class="form-group">
            <label>Supplier</label>
            <select name="invSupplier" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var s in Model.InvSuppliers)
                { <option value="@s" selected="@(Model.InvSupplier==s)">@s</option> }
            </select>
        </div>
        <a href="/Reports" class="btn btn-ghost btn-sm">Clear</a>
    </form>

    <div class="table-wrap">
        <table>
            <thead><tr><th>SKU</th><th>Product</th><th>Stock</th><th>Reorder</th><th>Cost/Unit</th><th>Total Cost</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var i in Model.InventoryRows.Take(50))
                {
                    var cls = i.Stock <= 0 ? "out" : i.Stock <= i.ReorderLevel ? "low" : "in";
                    var lbl = DataService.ComputeStatus(i.Stock, i.ReorderLevel);
                    <tr>
                        <td><code>@i.SKU</code></td><td>@i.ProductName</td><td>@i.Stock</td>
                        <td>@i.ReorderLevel</td><td>@i.CostPerUnit.ToString("C0")</td>
                        <td>@i.TotalOrderCost.ToString("C0")</td>
                        <td><span class="pill @cls">@lbl</span></td>
                    </tr>
                }
                @if (!Model.InventoryRows.Any())
                { <tr><td colspan="7" style="color:#6b7f95;text-align:center;padding:24px;">No inventory data</td></tr> }
            </tbody>
        </table>
    </div>

    <form method="post" asp-page-handler="ExportInventory" style="margin-top:16px;display:inline-flex;gap:8px;align-items:center;">
        <input type="hidden" name="invCategory" value="@Model.InvCategory"/>
        <input type="hidden" name="invSupplier" value="@Model.InvSupplier"/>
        <button type="submit" class="btn btn-primary btn-sm">⬇ Export Inventory CSV</button>
    </form>
</div>

<div class="card">
    <div class="card-title">Sales Report</div>
    <form method="get" class="filter-bar" style="margin-bottom:16px;">
        <input type="hidden" name="invCategory" value="@Model.InvCategory"/>
        <input type="hidden" name="invSupplier" value="@Model.InvSupplier"/>
        <div class="form-group">
            <label>Customer</label>
            <input type="text" name="salesCustomer" value="@Model.SalesCustomer" placeholder="Filter by customer…"/>
        </div>
        <div class="form-group">
            <label>From</label>
            <input type="date" name="salesFrom" value="@Model.SalesFrom"/>
        </div>
        <div class="form-group">
            <label>To</label>
            <input type="date" name="salesTo" value="@Model.SalesTo"/>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Filter</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead><tr><th>Date</th><th>Customer</th><th>Product</th><th>Qty</th><th>Unit</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var s in Model.SalesRows.Take(50))
                {
                    <tr>
                        <td>@(s.CreatedUtc == DateTime.MinValue ? "—" : s.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd"))</td>
                        <td>@s.Customer</td><td>@s.ProductName</td>
                        <td>@s.Quantity</td><td>@s.UnitPrice.ToString("C0")</td>
                        <td style="font-weight:600;">@s.TotalAmount.ToString("C0")</td>
                    </tr>
                }
                @if (!Model.SalesRows.Any())
                { <tr><td colspan="6" style="color:#6b7f95;text-align:center;padding:24px;">No sales data</td></tr> }
            </tbody>
        </table>
    </div>

    <form method="post" asp-page-handler="ExportSales" style="margin-top:16px;display:inline-flex;gap:8px;align-items:center;">
        <input type="hidden" name="salesCustomer" value="@Model.SalesCustomer"/>
        <input type="hidden" name="salesFrom" value="@Model.SalesFrom"/>
        <input type="hidden" name="salesTo" value="@Model.SalesTo"/>
        <button type="submit" class="btn btn-primary btn-sm">⬇ Export Sales CSV</button>
    </form>
</div>

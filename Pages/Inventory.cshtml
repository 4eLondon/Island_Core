@page
@model IslandCore.Pages.InventoryModel
@{
    ViewData["Title"] = "Inventory";
    ViewData["ActivePage"] = "Inventory";
}

<div class="kpi-grid">
    <div class="kpi"><div class="kpi-label">Total Items</div><div class="kpi-value">@Model.TotalItems</div></div>
    <div class="kpi"><div class="kpi-label">In Stock</div><div class="kpi-value">@Model.InStock</div></div>
    <div class="kpi"><div class="kpi-label">Low Stock</div><div class="kpi-value">@Model.LowStock</div></div>
    <div class="kpi"><div class="kpi-label">Out of Stock</div><div class="kpi-value">@Model.OutOfStock</div></div>
    <div class="kpi"><div class="kpi-label">Inventory Value</div><div class="kpi-value">@Model.InventoryValue.ToString("C0")</div></div>
</div>

<div class="card">
    <form method="get" class="filter-bar">
        <div class="form-group">
            <label>Category</label>
            <select name="category" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c" selected="@(Model.CategoryFilter==c)">@c</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Supplier</label>
            <select name="supplier" onchange="this.form.submit()">
                <option value="">All Suppliers</option>
                @foreach (var s in Model.Suppliers)
                {
                    <option value="@s" selected="@(Model.SupplierFilter==s)">@s</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Stock Status</label>
            <select name="status" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="In Stock"    selected="@(Model.StatusFilter=="In Stock")">In Stock</option>
                <option value="Low Stock"   selected="@(Model.StatusFilter=="Low Stock")">Low Stock</option>
                <option value="Out of Stock" selected="@(Model.StatusFilter=="Out of Stock")">Out of Stock</option>
            </select>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">Filter</button>
        <a href="/Inventory" class="btn btn-ghost btn-sm">Clear</a>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>SKU</th><th>Product</th><th>Category</th><th>Stock</th>
                    <th>Reorder Level</th><th>Supplier</th><th>Cost/Unit</th><th>Total Cost</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    var cls = i.Stock <= 0 ? "out" : i.Stock <= i.ReorderLevel ? "low" : "in";
                    var label = i.Stock <= 0 ? "Out of Stock" : i.Stock <= i.ReorderLevel ? "Low Stock" : "In Stock";
                    <tr>
                        <td><code>@i.SKU</code></td>
                        <td>@i.ProductName</td>
                        <td>@i.Category</td>
                        <td>@i.Stock</td>
                        <td>@i.ReorderLevel</td>
                        <td>@i.Supplier</td>
                        <td>@i.CostPerUnit.ToString("C0")</td>
                        <td>@i.TotalOrderCost.ToString("C0")</td>
                        <td><span class="pill @cls">@label</span></td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" style="text-align:center;color:#6b7f95;padding:32px;">No inventory data</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div style="font-size:13px;color:#6b7f95;margin-top:12px;">Showing @Model.Items.Count of @Model.TotalAll entries</div>
</div>

@page
@model IslandCore.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<div class="kpi-grid">
    <div class="kpi">
        <div class="kpi-label">Total Stock Units</div>
        <div class="kpi-value">@Model.TotalStockUnits</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Distinct Items</div>
        <div class="kpi-value">@Model.DistinctItems</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Low Stock Alerts</div>
        <div class="kpi-value">@Model.LowStockCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Inventory Value</div>
        <div class="kpi-value">@Model.InventoryValue.ToString("C0")</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Total Spent</div>
        <div class="kpi-value">@Model.TotalSpent.ToString("C0")</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">Total Earned</div>
        <div class="kpi-value">@Model.TotalEarned.ToString("C0")</div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
    <div class="card">
        <div class="card-title">Low Stock Items</div>
        @if (!Model.LowStockItems.Any())
        {
            <div class="chart-placeholder">No low stock items</div>
        }
        else
        {
            <ul style="list-style:none; display:flex; flex-direction:column; gap:8px;">
                @foreach (var item in Model.LowStockItems)
                {
                    <li style="display:flex; justify-content:space-between; font-size:14px;">
                        <span>@item.ProductName</span>
                        <span class="pill @(item.Stock <= 0 ? "out" : "low")">@item.Stock units</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="card">
        <div class="card-title">Category Distribution</div>
        @if (!Model.CategoryGroups.Any())
        {
            <div class="chart-placeholder">No inventory data</div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:6px;">
                @foreach (var g in Model.CategoryGroups)
                {
                    <div style="display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #f1f6fb; font-size:14px;">
                        <span style="font-weight:600;">@g.Key</span>
                        <span style="color:#6b7f95;">@g.Count item@(g.Count == 1 ? "" : "s")</span>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card" style="grid-column:1/-1;">
        <div class="card-title">Top Selling Products</div>
        @if (!Model.TopProducts.Any())
        {
            <div class="chart-placeholder">No sales data available</div>
        }
        else
        {
            <div style="display:flex; gap:16px; flex-wrap:wrap;">
                @foreach (var p in Model.TopProducts)
                {
                    <div style="flex:1; min-width:120px; text-align:center; background:#eef6ff; border-radius:8px; padding:16px;">
                        <div style="font-weight:700; color:#0b2946;">@p.Name</div>
                        <div style="font-size:12px; color:#6b7f95; margin-top:4px;">@p.TotalQty unit@(p.TotalQty == 1?"":"s") sold</div>
                    </div>
                }
            </div>
        }
    </div>
</div>
